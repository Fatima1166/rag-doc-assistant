# Copy to .env.local and adjust.
# Leave unset to run the frontend in demo mode (mock data, no backend).
# Point it at the RAGDocs backend (see the backend/ folder) for real answers.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Absolute public URL, used for SEO metadata / sitemap / OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Public repository URL; the landing footer only shows a GitHub link
# when this is set, so it never points at a page that doesn't exist.
# NEXT_PUBLIC_REPO_URL=https://github.com/yourname/ragdocs
