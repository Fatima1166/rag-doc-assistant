# Copy to .env and fill in. Only GROQ_API_KEY is needed for real AI answers.
# Everything else has sensible defaults and works with zero keys (retrieval + extractive fallback).

# Origin allowed by CORS (must match the frontend URL that calls this API).
FRONTEND_ORIGIN=http://localhost:3000

# Groq (OpenAI-compatible). Free key: https://console.groq.com/keys
# Leave empty to run in extractive mode (returns the most relevant passages, no LLM).
GROQ_API_KEY=
# Primary model. If it 404s / errors / returns only reasoning with no answer text,
# generation silently tries the next free model in GROQ_MODELS, then extractive.
GROQ_MODEL=qwen/qwen3.8-27b
# Ordered fallback list of free Groq chat models (comma-separated). GROQ_MODEL is
# always tried first. Set this to match the models your key can access
# (GET https://api.groq.com/openai/v1/models).
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b,allam-2-7b,openai/gpt-oss-safeguard-20b

# Accepted for parity with the frontend settings page. Stored per account, never
# read by the retriever: search is BM25 over SQLite, so this key changes nothing.
PINECONE_API_KEY=

# Retrieval / chunking tuning.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MAX_UPLOAD_MB=20

# How much retrieved text one prompt may carry. Tokens are estimated from
# characters (deliberately over-counted), so this is a safety ceiling against
# overflowing the model window, not an exact bill. Passages are picked for
# diversity (MMR) and merged across neighbours until this budget is spent.
CONTEXT_TOKENS=6000
# Cap on the answer itself, so max_tokens plus CONTEXT_TOKENS fits the model.
MAX_OUTPUT_TOKENS=1024
# How many extra hits retrieval pulls per question before diversity and merging
# trim it down to TOP_K. Higher = better choices, more work.
CANDIDATE_POOL=3
# Attempts on a Groq 429 / timeout before giving up. Only retried while nothing
# of the answer has been streamed yet, so a half-finished answer is never doubled.
GROQ_RETRIES=3
# Identical questions from the same account are replayed from cache for this many
# seconds (0 disables it). "Regenerate" in the chat always bypasses the cache.
ANSWER_CACHE_SECONDS=900

# Session token signing secret. REQUIRED in production (long random string).
# If left empty a secret is generated once and stored in data/secret.key.
SECRET_KEY=
# Session lifetime in days. 0 = tokens never expire (convenient for dev;
# a positive value is recommended in public deployments).
SESSION_DAYS=30

# Basic in-process rate limits (requests per minute). 0 disables the limiter.
# WARNING: with 0 there is no protection against brute-force login or chat
# spam / Groq cost abuse — recommended for local/dev use only.
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=30

# Password-reset email (stdlib smtplib). Leave SMTP_HOST empty to skip mail
# and log the reset link to the console instead (dev convenience).
# 587 = STARTTLS, 465 = implicit SSL. Gmail users: app password, not login pw.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RAGDocs <no-reply@example.com>

# Social sign-in (optional). Create an OAuth app with each provider and paste
# the credentials here. Register these redirect URIs (dev):
#   http://localhost:8000/api/auth/oauth/google/callback
#   http://localhost:8000/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Behind a reverse proxy, set the public backend base URL used to build the
# callback URI above (e.g. https://api.example.com).
# OAUTH_REDIRECT_BASE=

# Where the SQLite DB, uploaded files and the session secret live. Defaults to ./data
# API keys are stored inside the database, encrypted and per account.
# RAGDATA_DIR=./data

PORT=8000
